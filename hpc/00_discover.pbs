#!/bin/bash
#PBS -N dw_discover
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb
#PBS -l walltime=00:10:00
#PBS -l place=scatter:shared
#PBS -o discover.out
#PBS -e discover.err
#PBS -j oe

# Answers every unknown BEFORE any long job is queued.  Run this first, always.
cd ${PBS_O_WORKDIR:-$HOME}
echo "================ NODE ================"
hostname; date
echo "cores: $(nproc)   mem: $(free -g 2>/dev/null | awk '/Mem:/{print $2" GB"}')"
echo; echo "================ GPU ================"
nvidia-smi || echo "!! nvidia-smi failed -- is ngpus>0 set and is this the gpu queue?"
echo; echo "driver/cuda:"; nvidia-smi --query-gpu=name,memory.total,driver_version,compute_cap --format=csv 2>/dev/null
echo; echo "================ MODULES ================"
module avail 2>&1 | head -60
echo; echo "cuda modules:"; module avail 2>&1 | tr ' ' '\n' | grep -i cuda | head
echo; echo "================ QUEUES / LIMITS ================"
qstat -Qf 2>/dev/null | grep -E "^Queue|resources_max|resources_default|max_run|enabled|started" | head -40
echo; echo "================ STORAGE ================"
echo "-- home --"; df -h "$HOME" | tail -1; du -sh "$HOME" 2>/dev/null
echo "-- quota --"; quota -s 2>/dev/null || lfs quota -u "$USER" "$HOME" 2>/dev/null || echo "(no quota command)"
echo "-- candidate scratch paths --"
for p in /scratch /scratch/$USER /lustre /work /data /tmp /var/tmp "$HOME"; do
  [ -d "$p" ] && printf "%-20s %s\n" "$p" "$(df -h "$p" | tail -1)"
done
echo "-- inode usage --"; df -i "$HOME" | tail -1
echo; echo "================ INTERNET FROM COMPUTE NODE ================"
timeout 12 curl -sI https://huggingface.co >/dev/null 2>&1 \
  && echo "HTTPS to huggingface.co: OK (can download from compute nodes)" \
  || echo "HTTPS to huggingface.co: BLOCKED (must pre-stage assets from the login node)"
echo; echo "================ PYTHON / CONDA ================"
source /apps/anaconda3/bin/activate deeplearning 2>/dev/null && echo "activated 'deeplearning'" || echo "!! could not activate deeplearning"
which python; python -V
python - <<'PY' 2>&1
try:
    import torch
    print("torch", torch.__version__, "| cuda build", torch.version.cuda,
          "| cuda avail", torch.cuda.is_available())
    if torch.cuda.is_available():
        print("gpu:", torch.cuda.get_device_name(0),
              f"{torch.cuda.get_device_properties(0).total_memory/1e9:.0f} GB",
              "| bf16:", torch.cuda.is_bf16_supported())
except Exception as e:
    print("torch missing/broken:", e)
for m in ("transformers","h5py","rasterio","cv2","omegaconf"):
    try:
        __import__(m); print(f"{m}: present")
    except Exception as e:
        print(f"{m}: MISSING ({type(e).__name__})")
PY
echo; echo "================ DONE ================"; date
