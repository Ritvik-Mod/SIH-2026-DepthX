#!/bin/bash
#PBS -N dw_probe
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:20:00
#PBS -o logs/probe.out
#PBS -j oe
#
# Proves the transformers API path my code depends on, and measures REAL throughput on
# an L40 so every time estimate stops being extrapolation.
source "${PBS_O_WORKDIR}/hpc/_common.sh"

echo "=== node resources actually granted ==="
echo "ncpus visible: $(nproc)"
python - <<'PY'
import torch, time, sys
sys.path.insert(0, ".")
print("torch", torch.__version__, "| device", torch.cuda.get_device_name(0),
      "| bf16", torch.cuda.is_bf16_supported())

from heightmap import config
from heightmap.models.net import HeightNet
from heightmap.losses.combined import CombinedLoss

for ckpt, name in [("depth-anything/Depth-Anything-V2-Small-hf", "ViT-S"),
                   ("depth-anything/Depth-Anything-V2-Base-hf",  "ViT-B"),
                   ("depth-anything/Depth-Anything-V2-Large-hf", "ViT-L")]:
    for bs in (4, 8, 16):
        try:
            cfg = config.load(overrides=[f"model.checkpoint={ckpt}"])
            net = HeightNet(cfg).cuda(); net.train()
            lossfn = CombinedLoss(cfg)
            opt = torch.optim.AdamW(net.param_groups(1e-5, 5e-5, 1e-4, 0.01))
            b = {"image": torch.randn(bs,3,518,518).cuda(),
                 "gsd": torch.full((bs,), 0.33).cuda(),
                 "height": (torch.rand(bs,1,518,518)*30).cuda(),
                 "mask": torch.ones(bs,1,518,518, dtype=torch.bool).cuda(),
                 "cls": torch.randint(0,7,(bs,518,518)).cuda(),
                 "sun": torch.full((bs,2), float("nan")).cuda()}
            for i in range(6):                       # warm up, then time
                if i == 3:
                    torch.cuda.synchronize(); t0 = time.time()
                with torch.autocast("cuda", dtype=torch.bfloat16):
                    o = net(b["image"], b["gsd"]); loss,_ = lossfn(o, b)
                opt.zero_grad(set_to_none=True); loss.backward(); opt.step()
            torch.cuda.synchronize()
            dt = (time.time()-t0)/3
            peak = torch.cuda.max_memory_allocated()/1e9
            print(f"  {name} bs={bs:2d}: {bs/dt:6.1f} img/s  {dt*1000:7.0f} ms/step  peak {peak:5.1f} GB")
            del net, opt, b, o, loss; torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()
        except torch.cuda.OutOfMemoryError:
            print(f"  {name} bs={bs:2d}: OOM")
            torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()
        except Exception as e:
            print(f"  {name} bs={bs:2d}: FAILED {type(e).__name__}: {e}")
            torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats()
            break

print("\n5,004 train tiles -> projected wall-clock per run:")
PY
