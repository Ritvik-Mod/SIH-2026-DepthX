#!/bin/bash
#PBS -N dw_rgn
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=01:30:00
#PBS -o logs/rgn.out
#PBS -j oe
#
# Per-block relative gradient norm on two domains, to decide WHICH blocks to fine-tune
# instead of arguing about it.  Nothing is trained; no checkpoint is written.
#
#   qsub hpc/24_rgnprobe.pbs
#   qsub -v REF="DC PHL",SHIFT=NYC,TILES=128 hpc/24_rgnprobe.pbs
#
# THE CHECKPOINT MUST NOT HAVE TRAINED ON THE SHIFTED CITY.
# a7_vitl trained on the OFFICIAL split, which contains NYC -- so for a7_vitl, NYC is
# in-domain and this probe would measure tile difficulty, not domain shift.  The
# holdout run (DC+PHL only) is the one NYC is genuinely held out from, and it is the
# only correct default here.
source "${PBS_O_WORKDIR}/hpc/_common.sh"

: "${CKPT:=outputs/holdout_vitl/best.pt}"
: "${REF:=DC PHL}"
: "${SHIFT:=NYC}"
: "${TILES:=128}"
: "${BATCHES:=16}"
: "${BATCH:=4}"

python scripts/rgn_probe.py \
    --ckpt "$CKPT" \
    --root "$DATA_ROOT/GAMUS" \
    --ref-cities $REF \
    --shift-cities $SHIFT \
    --splits val test \
    --tiles "$TILES" \
    --batches "$BATCHES" \
    --batch "$BATCH" \
    --device cuda \
    --out outputs/rgn_probe.json
